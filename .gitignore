# ==========================================
# hs2json - .gitignore
# Regras para ignorar binários e artefatos de compilação
# ==========================================

# Diretórios e caches de compilação do Cabal
dist/
dist-*
dist-newstyle/
cabal-dev/
.cabal-sandbox/
cabal.sandbox.config
cabal.project.local
cabal.project.local~
.ghc.environment.*

# Executáveis binários gerados
*.exe
*.exe~
*.bin
*.out
*.app

# Objetos e interfaces compiladas (GHC)
*.o
*.hi
*.hie
*.chi
*.chs.h
*.dyn_o
*.dyn_hi
*.dump-*

# Bibliotecas estáticas e dinâmicas
*.a
*.lib
*.so
*.dylib
*.dll

# Profiling, métricas e logs
*.prof
*.aux
*.hp
*.eventlog

# Cobertura de código e relatórios de teste (HPC, HTF)
*.tix
.hpc/
.HTF/

# Ferramentas alternativas e ambientes (Stack, hsenv)
.stack-work/
.hsenv/

# Arquivos de IDE e do Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
